# Copie para .env.local e preencha. .env.local NUNCA vai para o Git.

# ── Trava de publicação ─────────────────────────────────────────
# false = site bloqueado para buscadores e com faixa de rascunho visível.
# Só vira true no dia do lançamento, e só na Vercel.
NEXT_PUBLIC_SITE_LIVE=false

# ── URL base ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Formulário de contato (só na Sprint 5) ──────────────────────
RESEND_API_KEY=
CONTATO_DESTINO=

# ── Analytics: deixar vazio até o lançamento ────────────────────
NEXT_PUBLIC_GA_ID=
